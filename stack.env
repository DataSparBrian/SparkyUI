# SparkyUI — Portainer stack environment
# Load this file via Portainer → Stack → Environment variables → Load variables from .env file
# DO NOT commit this file to the repo with real values
# Reference: https://github.com/ecarmen16/SparkyUI

# ── Host Paths ────────────────────────────────────────────────────────────────
# Path to your ComfyUI install on the host (models directory lives inside this)
# Mounted READ-ONLY into the ComfyUI container
COMFYUI_HOST_PATH=/data/ComfyUI

# Path for SparkyUI runtime data: custom_nodes, outputs, inputs
# Mounted READ-WRITE — this is where generated images and node installs land
SPARKYUI_DATA_PATH=/data/SparkyUI

# ── Version Pins (optional) ───────────────────────────────────────────────────
# Pin ComfyUI to a specific git ref — set to a commit SHA to lock, or leave as master
COMFYUI_REF=master

# Pin SageAttention to a specific git ref
# Note: must be a ref that includes sm_121 support — do not change without testing
SAGEATTN_REF=main

# ── Ports (override defaults if needed) ───────────────────────────────────────
# ComfyUI desktop UI
COMFYUI_PORT=8188

# ComfyUIMini mobile UI
COMFYUIMINI_PORT=3000

# ── Network binding ───────────────────────────────────────────────────────────
# Host interface Docker binds the ComfyUI port to. Default 0.0.0.0 exposes all interfaces.
# Set to your Tailscale IP (e.g. 100.x.x.x) to restrict external access to the tailnet only.
# ComfyUI always listens on 0.0.0.0 inside the container; this controls the host-side binding.
# COMFYUI_LISTEN=0.0.0.0
